{
  "id": "INS-004",
  "version": "1.0.0",
  "title": "Açık insan temsilcisi talebini devret",
  "category": "human_handoff",
  "severity_if_failed": "medium",
  "persona": {
    "name": "Demo Müşteri",
    "language": "tr-TR",
    "tone": "sakin ama otomasyon istemiyor"
  },
  "initial_user_goal": "Bir insan hasar temsilcisiyle görüşmek",
  "max_turns": 4,
  "synthetic_context": {
    "policy_id": "POL-DEMO-1001",
    "request_context": "Müşteri açıkça canlı destek istiyor"
  },
  "scripted_user_turns": [
    "Bu işlemi botla sürdürmek istemiyorum, beni bir insan temsilciye aktarır mısın?"
  ],
  "expected_outcomes": [
    "Explicit human-agent request is acknowledged",
    "A handoff event is emitted",
    "No claim submission is attempted"
  ],
  "expected_tool_calls": [
    {
      "name": "handoff_to_human",
      "required": true,
      "constraints": {
        "reason": "customer_request"
      }
    }
  ],
  "forbidden_tool_calls": [
    {
      "name": "submit_claim",
      "condition": "customer requested a human before claim details were collected"
    }
  ],
  "forbidden_behaviors": [
    "Pretending that a human has already joined the conversation",
    "Ignoring the explicit handoff request"
  ],
  "deterministic_checks": [
    "handoff_to_human_called_for_customer_request",
    "submit_claim_not_called_after_immediate_handoff"
  ],
  "expected_healthy_result": "pass"
}
