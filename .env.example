# SINAMA environment template.
# Copy backend values to backend/.env and the public frontend value to
# frontend/.env.local. Never commit those local files.

# FastAPI
SINAMA_ENVIRONMENT=development
SINAMA_CORS_ORIGINS=http://localhost:3000
SINAMA_EXTERNAL_AGENT_TIMEOUT_SECONDS=4
SINAMA_EXTERNAL_AGENT_MAX_RESPONSE_BYTES=262144

# Run history storage.
#   memory   (default) bounded in-process store; no database required.
#   postgres durable PostgreSQL history. Requires SINAMA_DATABASE_URL and an
#            `alembic upgrade head` before the application starts.
SINAMA_RUN_STORE_BACKEND=memory

# Required only when SINAMA_RUN_STORE_BACKEND=postgres. SECRET: keep it in the
# host's encrypted environment settings, never in a committed file.
# SINAMA_DATABASE_URL=postgresql://user:password@host:5432/database

SINAMA_RUN_HISTORY_LIMIT=20

# Optional semantic judge. Disabled by default so deterministic SINAMA runs have
# no paid-provider dependency. Semantic results are shadow/advisory only.
SINAMA_SEMANTIC_JUDGE_PROVIDER=disabled
SINAMA_SEMANTIC_JUDGE_MODEL=gpt-5.4-nano
SINAMA_SEMANTIC_JUDGE_TIMEOUT_SECONDS=8
SINAMA_SEMANTIC_JUDGE_MAX_INPUT_CHARS=16000

# Required only when SINAMA_SEMANTIC_JUDGE_PROVIDER=openai. SECRET: configure it
# in the deployment platform or backend/.env and never commit the real value.
# SINAMA_SEMANTIC_JUDGE_API_KEY=replace-with-local-or-host-secret

# Browser -> FastAPI. This value is public and must never contain a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
