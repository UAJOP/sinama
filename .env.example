# SINAMA first-slice environment template.
# Copy the backend values to backend/.env and the public frontend value to
# frontend/.env.local. Never commit those local files.

# FastAPI
SINAMA_ENVIRONMENT=development
SINAMA_CORS_ORIGINS=http://localhost:3000
SINAMA_EXTERNAL_AGENT_TIMEOUT_SECONDS=4
SINAMA_EXTERNAL_AGENT_MAX_RESPONSE_BYTES=262144

# Run history storage.
#   memory   (default) bounded in-process store; no database required. Local
#            development, the demo and the test suite all run on this.
#   postgres durable PostgreSQL history. Requires SINAMA_DATABASE_URL, and the
#            schema must be created first with `alembic upgrade head`.
SINAMA_RUN_STORE_BACKEND=memory

# Required only when SINAMA_RUN_STORE_BACKEND=postgres. This is a SECRET: keep it
# in the host's encrypted environment settings, never in a committed file.
# Works with any standard PostgreSQL URL, including Supabase.
# SINAMA_DATABASE_URL=postgresql://user:password@host:5432/database

# How many runs the recent-history API returns by default, and the retention
# bound of the memory backend. PostgreSQL keeps full history regardless.
SINAMA_RUN_HISTORY_LIMIT=20

# Browser -> FastAPI. This value is public and must never contain a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# This slice deliberately has no LLM provider configuration.
