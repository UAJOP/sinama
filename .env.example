# SINAMA environment template
# Copy this file to .env locally. Never commit real credentials.

SINAMA_ENV=development

# Frontend -> backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database / Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# Optional LLM provider used by synthetic users and semantic evaluators.
# Keep real keys only in local/server environment variables.
OPENAI_API_KEY=

# Runtime defaults
AGENT_REQUEST_TIMEOUT_SECONDS=30
MAX_SCENARIO_TURNS=12

# Do not put service-role keys, production secrets or customer credentials
# in NEXT_PUBLIC_* variables. They are exposed to the browser bundle.
